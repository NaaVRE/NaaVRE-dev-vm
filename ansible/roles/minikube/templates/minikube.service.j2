[Unit]
Description=minikube
After=network-online.target ufw.service containerd.service docker.service
Wants=network-online.target docker.service
Requires=docker.socket containerd.service docker.service

[Service]
Type=simple
RemainAfterExit=no
TimeoutStartSec=600
ExecStartPre=/usr/bin/minikube start \
  --addons=ingress,ingress-dns \
  --cpus={{ ansible_facts['processor_vcpus'] }} \
  --memory={{ ansible_facts['memtotal_mb'] }}m \
  --network=minikube0 \
  --disk-size={{ minikube_disk_size }} \
  --static-ip={{ minikube_ip }}
ExecStartPre=/usr/bin/bash -c 'cm=$(minikube kubectl -- -n kube-system get configmap/coredns -o json | jq ".data.Corefile += \\"test:53 {\\n  errors\\n  cache 30\\n  forward . {{ minikube_ip }}\\n}\\"" | jq "del(.metadata)"); minikube kubectl -- -n kube-system patch configmap/coredns --type merge -p "$cm"'
ExecStartPre=/usr/bin/bash -c '/usr/bin/minikube kubectl -- config view --flatten > "{{ minikube_kubeconfig_path }}"'
ExecStart=/usr/bin/minikube logs -f
ExecStop=/usr/bin/minikube stop
User={{ ansible_user }}
Group={{ ansible_user }}
WorkingDirectory=/home/{{ ansible_user }}

[Install]
WantedBy=multi-user.target
